# Copy to .env and fill in.

# Postgres (used by docker-compose to create the db and build DATABASE_URL)
POSTGRES_USER=fborderbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fborderbot

# Only used when running the app outside docker-compose
DATABASE_URL=postgres://fborderbot:change-me@localhost:5432/fborderbot?sslmode=disable

# Facebook / Meta
FB_WEBHOOK_VERIFY_TOKEN=choose-any-random-string
FB_APP_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: debug | info | warn | error
LOG_LEVEL=info
